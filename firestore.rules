rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Registered Farmers Index Collection (Phone-based farmer auth & registration)
    match /registered_farmers/{phone} {
      allow read, write: if true;

      // Allow all subcollections under registered_farmers (expenses, crop_sales, chat_messages, etc.)
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }

    // Farmer Profile Collection & Subcollections (Expenses, Sales, Calculator, Chat History)
    match /farmers/{userId} {
      allow read, write: if true;

      // Allow all subcollections under farmers (expenses, crop_sales, chat_messages, calculator_summary, etc.)
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
