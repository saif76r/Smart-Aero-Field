{
  "entities": {
    "FarmerProfile": {
      "title": "FarmerProfile",
      "description": "Profile and farm characteristics of a farmer",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID of the farmer" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "division": { "type": "string", "maxLength": 50 },
        "district": { "type": "string", "maxLength": 50 },
        "upazila": { "type": "string", "maxLength": 50 },
        "farmSizeAcres": { "type": "number" },
        "soilType": { "type": "string", "maxLength": 50 },
        "primaryCrops": { "type": "array" },
        "experienceYears": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "name", "district"]
    },
    "SupplyExpense": {
      "title": "SupplyExpense",
      "description": "An input supply expense item for a farmer batch",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID of the farmer" },
        "category": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 120 },
        "amount": { "type": "number" },
        "unit": { "type": "string", "maxLength": 30 },
        "cost": { "type": "number" },
        "dateAdded": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "category", "name", "cost"]
    },
    "CropSale": {
      "title": "CropSale",
      "description": "Sales record and revenue of crops harvested",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID of the farmer" },
        "cropName": { "type": "string", "maxLength": 100 },
        "quantity": { "type": "number" },
        "unit": { "type": "string", "maxLength": 30 },
        "pricePerUnit": { "type": "number" },
        "totalSaleAmount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "totalSaleAmount"]
    },
    "RegisteredFarmer": {
      "title": "RegisteredFarmer",
      "description": "Farmers registered with phone number and credentials",
      "type": "object",
      "properties": {
        "phone": { "type": "string", "maxLength": 30 },
        "name": { "type": "string", "maxLength": 100 },
        "pin": { "type": "string", "maxLength": 50 },
        "district": { "type": "string", "maxLength": 50 },
        "landSize": { "type": "string", "maxLength": 20 },
        "crop": { "type": "string", "maxLength": 50 },
        "authUid": { "type": "string" },
        "registeredAt": { "type": "string" }
      },
      "required": ["phone", "name", "district"]
    },
    "AIChatMessage": {
      "title": "AIChatMessage",
      "description": "User and AI agronomist chat history messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "bot"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "language": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "sender", "text"]
    },
    "CalculatorSummary": {
      "title": "CalculatorSummary",
      "description": "Supplies expense and profit/loss calculation summary",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "totalCost": { "type": "number" },
        "totalRevenue": { "type": "number" },
        "netProfitLoss": { "type": "number" },
        "status": { "type": "string" },
        "expensesCount": { "type": "number" },
        "cropName": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "totalCost", "totalRevenue", "netProfitLoss"]
    }
  },
  "firestore": {
    "/registered_farmers/{phone}": {
      "schema": "RegisteredFarmer",
      "description": "Registered farmers lookup by phone number"
    },
    "/farmers/{userId}": {
      "schema": "FarmerProfile",
      "description": "Farmer profile documents keyed by Auth UID"
    },
    "/farmers/{userId}/expenses/{expenseId}": {
      "schema": "SupplyExpense",
      "description": "Farmer input expenses"
    },
    "/farmers/{userId}/crop_sales/{saleId}": {
      "schema": "CropSale",
      "description": "Farmer crop sales revenue records"
    },
    "/farmers/{userId}/chat_messages/{messageId}": {
      "schema": "AIChatMessage",
      "description": "Historical AI chat messages"
    },
    "/farmers/{userId}/calculator_summary/current": {
      "schema": "CalculatorSummary",
      "description": "Summary of active supplies expenses and profit/loss calculation"
    }
  }
}
